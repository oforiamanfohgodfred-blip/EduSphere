PORT=5000
# Preferred for local or hosted PostgreSQL:
DATABASE_URL=postgresql://username:password@localhost:5432/edusphere
# Set DB_SSL=true for managed PostgreSQL providers that require TLS.
DB_SSL=false
# Optional fallback when DATABASE_URL is not provided:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_NAME=edusphere
JWT_SECRET=replace-with-a-long-random-secret
# Required in production to restrict browser access to the deployed frontend.
FRONTEND_URL=http://localhost:5173
